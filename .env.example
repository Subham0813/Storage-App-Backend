# ─────────────────────────────────────────────────────────────────────────────
# StorageApp Backend — Environment Configuration
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# The server validates required variables at startup (see misc/constants.js).
# ─────────────────────────────────────────────────────────────────────────────

# ── Core ──────────────────────────────────────────────────────────────────────
NODE_ENV=development                 # development | production
PORT=4000                            # API server port
APP_MODE=selfhosted                  # selfhosted | saas (enables Razorpay billing)
APP_NAME=StorageApp                  # used in emails / branding
COOKIE_SECRET=change-me-in-production
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
MUTATING_METHODS=POST,PATCH,PUT,DELETE

# ── Database & Cache ─────────────────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/storageapp

REDIS_URL=redis://localhost:6379     # used for sessions & upload sessions
# BullMQ job queue connection (defaults to 127.0.0.1:6379)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# ── Object Storage (Bring Your Own — AWS S3 / Cloudflare R2 / Backblaze B2 / MinIO)
# Main storage bucket for user files
STORAGE_ENDPOINT=                    # optional for AWS; required for R2/B2/MinIO
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=your_storage_access_key
STORAGE_SECRET_KEY=your_storage_secret_key
STORAGE_BUCKET_NAME=your-files-bucket
STORAGE_FORCE_PATH_STYLE=false       # true for MinIO/B2-compatible endpoints

# Public storage bucket (thumbnails, avatars, share assets)
PUBLIC_ENDPOINT=
PUBLIC_REGION=us-east-1
PUBLIC_ACCESS_KEY=your_public_access_key
PUBLIC_SECRET_KEY=your_public_secret_key
PUBLIC_BUCKET_NAME=your-public-bucket
PUBLIC_BUCKET_CDN=https://cdn.yourdomain.com

# Legacy bucket alias used by ZIP streaming & batch deletes — set to STORAGE_BUCKET_NAME
B2_BUCKET_NAME=your-files-bucket

# ── CDN (optional — pick one provider for preview/download URL signing) ───────
# Leave CDN_PROVIDER empty to fall back to native S3 pre-signed URLs.
CDN_PROVIDER=                        # cloudflare | cloudfront | (empty)
CDN_DOMAIN=

# Cloudflare Worker (HMAC-signed /stream + /download routes).
# SaaS-only: the bandwidth webhook (POST /api/files/webhook) is disabled in
# self-hosted mode, which falls back to server-side bandwidth tracking instead.
CLOUDFLARE_WEBHOOK_SECRET=your_shared_webhook_secret

# AWS CloudFront (signed URLs)
CLOUDFRONT_URL=
CLOUDFRONT_PRIVATE_KEY=
CLOUDFRONT_PUBLIC_KEY_ID=

# ── Google OAuth (sign-in + Drive import) ────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=https://api.yourdomain.com/api/oauth/google/callback
GOOGLE_DRIVE_REDIRECT_URI=https://api.yourdomain.com/api/oauth/google-drive/callback

# ── GitHub OAuth (optional — sign-in only) ───────────────────────────────────
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=https://api.yourdomain.com/api/oauth/github/callback

# ── Frontend URLs ────────────────────────────────────────────────────────────
CLIENT_AUTH_CALLBACK_URL=https://app.yourdomain.com   # OAuth post-login redirect base
CLIENT_APP_URL=https://app.yourdomain.com              # link target in emails
CLIENT_URL=https://app.yourdomain.com                  # checkout/pricing links (jobs)

# ── Security ─────────────────────────────────────────────────────────────────
# AES-256-GCM key used to encrypt OAuth tokens at rest. 32+ char secret.
OAUTH_TOKEN_ENCRYPTION_KEY=change-me-32-char-minimum-secret

# ── Email (BYO provider — Resend HTTP API or any SMTP relay) ──────────────────
# EMAIL_PROVIDER selects the transport. Default "resend".
#   resend -> requires RESEND_API_KEY below
#   smtp   -> requires SMTP_HOST, SMTP_PORT, SMTP_USER, SMTP_PASS
# OTP + password-reset emails are sent in ALL modes. Action/notification emails
# (share, ban/recover, feedback, invoice, abandoned-cart, subscription) are
# SaaS-only and never attempted in self-hosted mode.
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_your_resend_api_key
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
FROM_EMAIL=noreply@yourdomain.com
ADMIN_EMAIL=                         # optional: inbox for feedback/admin alerts
SUPPORT_EMAIL=support@yourdomain.com  # shown in account-ban emails

# ── Billing (Razorpay — SaaS mode only, APP_MODE=saas) ───────────────────────
RAZORPAY_KEY_ID=                     # live key
RAZORPAY_KEY_SECRET=                 # live secret
RAZORPAY_WEBHOOK_SECRET=             # live webhook secret
# Test mode keys (used automatically when NODE_ENV !== production)
TEST_RAZORPAY_KEY_ID=
TEST_RAZORPAY_KEY_SECRET=
TEST_RAZORPAY_WEBHOOK_SECRET=

# Razorpay subscription plan IDs (create in Razorpay Dashboard)
SUBSCRIPTION_PLAN_PRO_MONTHLY=
SUBSCRIPTION_PLAN_PRO_YEARLY=
SUBSCRIPTION_PLAN_ULTRA_MONTHLY=
SUBSCRIPTION_PLAN_ULTRA_YEARLY=
SUBSCRIPTION_PLAN_PREMIUM_MONTHLY=
SUBSCRIPTION_PLAN_PREMIUM_YEARLY=
SUBSCRIPTION_PLAN_ELITE_MONTHLY=
SUBSCRIPTION_PLAN_ELITE_YEARLY=

# Razorpay single-use offer IDs (discount codes)
RAZORPAY_OFFER_FIRST_SUB_25_OFF=
RAZORPAY_OFFER_200_OFF=
RAZORPAY_OFFER_150_OFF=
RAZORPAY_OFFER_100_OFF=
RAZORPAY_OFFER_75_OFF=
RAZORPAY_OFFER_50_OFF=
RAZORPAY_OFFER_25_OFF=

# ── Misc (optional — defaults provided) ──────────────────────────────────────
MAX_DEPTH=10                         # max nesting depth for ZIP streaming
