# Example environment variables for local development
# Copy this file to .env and fill in the values. Do NOT commit real secrets.
# Server Configuration
NODE_ENV=
PORT=

# Database
MONGO_URI=


# Session-cookie
COOKIE_SECRET= 

# Google OAuth (used for sign-in and Drive import)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_DRIVE_REDIRECT_URI=

# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=

# Others
UPLOAD_ROOT= 
TEMP_ROOT=
MAX_DEVICE_COUNT=
MAX_DEPTH=
